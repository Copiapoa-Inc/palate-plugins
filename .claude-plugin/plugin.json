{
  "name": "palate",
  "version": "0.2.0",
  "description": "Save and organize your source material — links, papers, podcasts, videos, feeds — into collections your AI can query with citations.",
  "author": { "name": "Palate", "url": "https://palate.inc" },
  "homepage": "https://palate.inc/for-agents",
  "userConfig": {
    "api_key": {
      "type": "string",
      "title": "Palate API Key",
      "description": "Get one at https://palate.inc/settings/keys",
      "sensitive": true
    }
  },
  "mcpServers": {
    "palate": {
      "type": "http",
      "url": "https://palate.inc/mcp",
      "headers": { "palate-api-key": "${user_config.api_key}", "palate-client": "claude-plugin" }
    }
  }
}
